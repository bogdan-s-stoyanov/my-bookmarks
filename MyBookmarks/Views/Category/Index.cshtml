@model List<CategoryListItemViewModel>

@{
    ViewData["Title"] = "My categories";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No categories found.
    </div>
}
else
{
    <ul class="list-group">
        @foreach (var category in Model)
        {
            <li class="list-group-item">
                @category.Name
            </li>
        }
    </ul>
}