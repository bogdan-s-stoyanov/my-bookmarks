@model CollectionDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h2 mb-0 text-break">@Model.Name</h1>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to collections
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p class="text-muted text-break mb-4">@Model.Description</p>
}

<a asp-action="AddBookmarks"
   asp-route-id="@Model.Id"
   class="btn btn-primary mb-4">
    Add bookmarks
</a>

@if (Model.BookmarksPage.Bookmarks.Count == 0)
{
    <div class="alert alert-info">
        This collection has no bookmarks yet.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var bookmark in Model.BookmarksPage.Bookmarks)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 text-break">@bookmark.Title</h2>

                        <p class="small text-muted text-break">
                            @bookmark.Url
                        </p>

                        <p class="text-muted">
                            @(bookmark.CategoryName ?? "Uncategorized")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(bookmark.Description))
                        {
                            <p class="text-break">@bookmark.Description</p>
                        }

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a href="@bookmark.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary">
                                Open link
                            </a>

                            <form asp-action="RemoveBookmark" method="post">
                                <input type="hidden"
                                       name="collectionId"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="bookmarkId"
                                       value="@bookmark.Id" />

                                <input type="hidden"
                                       name="pageNumber"
                                       value="@Model.BookmarksPage.PageNumber" />

                                <button type="submit" class="btn btn-outline-danger">
                                    Remove from collection
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

@if (Model.BookmarksPage.TotalPages > 1)
{
    <nav class="d-flex flex-wrap justify-content-center align-items-center gap-3 mt-4"
         aria-label="Collection bookmark pages">
        @if (Model.BookmarksPage.PageNumber > 1)
        {
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               asp-route-pageNumber="@(Model.BookmarksPage.PageNumber - 1)"
               class="btn btn-outline-primary">
                Previous
            </a>
        }

        <span>
            Page @Model.BookmarksPage.PageNumber
            of @Model.BookmarksPage.TotalPages
        </span>

        @if (Model.BookmarksPage.PageNumber < Model.BookmarksPage.TotalPages)
        {
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               asp-route-pageNumber="@(Model.BookmarksPage.PageNumber + 1)"
               class="btn btn-outline-primary">
                Next
            </a>
        }
    </nav>
}