@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyBookmarks</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/templates/sb-admin/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyBookmarks.styles.css" asp-append-version="true" />
</head>
<body class="sb-nav-fixed @(isAuthenticated ? "" : "guest-layout")">
    <header>
        <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
            <a class="navbar-brand ps-3" asp-area="" asp-controller="Home" asp-action="Index">MyBookmarks</a>
            @if (isAuthenticated)
            {
                <button class="btn btn-link btn-sm text-white"
                        id="sidebarToggle"
                        type="button"
                        aria-label="Toggle navigation">
                    ☰
                </button>
            }
            <div class="ms-auto me-3">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div id="layoutSidenav">
        @if (isAuthenticated)
        {
            <div id="layoutSidenav_nav">
                <nav class="sb-sidenav sb-sidenav-dark" aria-label="Main navigation">
                    <div class="sb-sidenav-menu">
                        <div class="nav">
                            <div class="sb-sidenav-menu-heading">MyBookmarks</div>
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"> Home </a>
                            <a class="nav-link" asp-area="" asp-controller="Category" asp-action="Index"> Categories </a>
                        </div>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="sb-sidenav-footer">
                            <div class="small">Logged in as:</div>
                            <div class="text-break">
                                @User.Identity.Name
                            </div>
                        </div>
                    }
                </nav>
            </div>
        }
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4 py-4">@RenderBody()</div>
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/templates/sb-admin/js/scripts.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
