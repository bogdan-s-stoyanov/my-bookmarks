@using Microsoft.AspNetCore.Mvc.Rendering
@model BookmarkIndexViewModel

@{
    ViewData["Title"] = "My bookmarks";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>

    <a asp-action="Create" class="btn btn-primary">
        Add bookmark
    </a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-5">
            <label asp-for="SearchTerm" class="form-label">
                Search by title
            </label>

            <input asp-for="SearchTerm"
                   type="search"
                   class="form-control"
                   placeholder="Enter a bookmark title..." />
        </div>

        <div class="col-12 col-md-4">
            <label asp-for="CategoryId" class="form-label">
                Category
            </label>

            <select asp-for="CategoryId"
                    asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"
                    class="form-select">
                <option value="">All categories</option>
            </select>
        </div>

        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </div>
</form>

@if (Model.Bookmarks.Count == 0)
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue)
        {
            <span>No bookmarks match your search or filters.</span>
        }
        else
        {
            <span>You haven't saved any bookmarks yet.</span>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var bookmark in Model.Bookmarks)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2">
                            <h2 class="h5 text-break">
                                @bookmark.Title
                            </h2>

                            <form asp-action="ToggleFavorite"
                                  method="post"
                                  class="flex-shrink-0">
                                <input type="hidden"
                                       name="id"
                                       value="@bookmark.Id" />

                                <input type="hidden"
                                       name="pageNumber"
                                       value="@Model.PageNumber" />

                                <input type="hidden"
                                       name="searchTerm"
                                       value="@Model.SearchTerm" />

                                <input type="hidden"
                                       name="categoryId"
                                       value="@Model.CategoryId" />

                                <button type="submit"
                                        class="btn btn-link text-decoration-none fs-4 p-0 @(bookmark.IsFavorite ? "text-danger" : "text-secondary")"
                                        aria-label="@(bookmark.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                                        aria-pressed="@(bookmark.IsFavorite ? "true" : "false")">
                                    <span aria-hidden="true">
                                        @(bookmark.IsFavorite ? "♥" : "♡")
                                    </span>
                                </button>
                            </form>
                        </div>

                        <p class="small text-muted text-break">
                            @bookmark.Url
                        </p>

                        <p class="text-muted">
                            @(bookmark.CategoryName ?? "Uncategorized")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(bookmark.Description))
                        {
                            <p class="text-break">
                                @bookmark.Description
                            </p>
                        }

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a href="@bookmark.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary">
                                Open link
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@bookmark.Id"
                               class="btn btn-outline-secondary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@bookmark.Id"
                               class="btn btn-outline-danger">
                                Delete
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="d-flex flex-wrap justify-content-center align-items-center gap-3 mt-4"
         aria-label="Bookmark pages">
        @if (Model.PageNumber > 1)
        {
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageNumber - 1)"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-categoryId="@Model.CategoryId"
               class="btn btn-outline-primary">
                Previous
            </a>
        }

        <span>
            Page @Model.PageNumber of @Model.TotalPages
        </span>

        @if (Model.PageNumber < Model.TotalPages)
        {
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageNumber + 1)"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-categoryId="@Model.CategoryId"
               class="btn btn-outline-primary">
                Next
            </a>
        }
    </nav>
}