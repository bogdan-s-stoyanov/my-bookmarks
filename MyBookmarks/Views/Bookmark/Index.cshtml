@model BookmarkIndexViewModel

@{
    ViewData["Title"] = "My bookmarks";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add bookmark
</a>

<form asp-action="Index" method="get" class="mb-4">
    <label asp-for="SearchTerm" class="form-label">
        Search by title
    </label>

    <div class="d-flex flex-wrap gap-2">
        <input asp-for="SearchTerm"
               type="search"
               class="form-control flex-grow-1 w-auto"
               placeholder="Enter a bookmark title..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

@if (Model.Bookmarks.Count == 0)
{
    <div class="alert alert-info">
        You haven't saved any bookmarks yet.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var bookmark in Model.Bookmarks)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2">
                            <h2 class="h5 text-break">
                                @bookmark.Title
                            </h2>
                            <form asp-controller="Bookmark"
                                  asp-action="ToggleFavorite"
                                  method="post"
                                  class="flex-shrink-0">
                                <input type="hidden" name="id" value="@bookmark.Id" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />

                                <button type="submit"
                                        class="btn btn-link text-decoration-none fs-4 p-0 @(bookmark.IsFavorite ? "text-danger" : "text-secondary")"
                                        aria-label="@(bookmark.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                                        aria-pressed="@(bookmark.IsFavorite ? "true" : "false")">
                                    <span aria-hidden="true">
                                        @(bookmark.IsFavorite ? "♥" : "♡")
                                    </span>
                                </button>
                            </form>
                        </div>
                        <p class="small text-muted text-break">
                            @bookmark.Url
                        </p>
                        <p class="text-muted">
                            @(bookmark.CategoryName ?? "Uncategorized")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(bookmark.Description))
                        {
                            <p class="text-break">
                                @bookmark.Description
                            </p>
                        }

                        <div class="mt-auto">
                            <a href="@bookmark.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary">
                                Open link
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@bookmark.Id"
                               class="btn btn-outline-secondary">
                                Edit
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@bookmark.Id"
                               class="btn btn-outline-danger">
                                Delete
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}